# Copy to .env and adjust. Every setting has a working, fully-local default --
# see src/cognivore/config.py for the complete list and descriptions.

# Path to a local GGUF model for llama-cpp-python. Leave unset to run with
# FakeLLMBackend (a deterministic offline demo backend -- no download needed).
# Example models: Qwen2.5-3B-Instruct-GGUF, Llama-3.2-3B-Instruct-GGUF.
# COGNIVORE_LLM_MODEL_PATH=/home/anton/models/qwen2.5-3b-instruct-q4_k_m.gguf

# Or point at a running Ollama server instead -- 'auto' (the default
# COGNIVORE_LLM_PROVIDER) tries this first. Inside docker-compose.yml this
# is already set to http://ollama:11434 for you.
# COGNIVORE_OLLAMA_HOST=http://127.0.0.1:11434
# COGNIVORE_OLLAMA_MODEL=qwen2.5:3b

# COGNIVORE_LLM_CONTEXT_LENGTH=4096
# COGNIVORE_LLM_N_THREADS=8
# COGNIVORE_LLM_TEMPERATURE=0.2

# COGNIVORE_HOST=127.0.0.1
# COGNIVORE_PORT=8420

# Speech recognition model (faster-whisper): tiny, base, small, medium,
# large-v3. "small" (~480 MB, downloaded on first use) is the smallest that
# reliably transcribes the nine UI languages; "base" (~150 MB) is faster but
# often mishears non-English speech.
# COGNIVORE_WHISPER_MODEL_SIZE=small

# Tesseract language packs for reading on-screen text in videos. "auto"
# uses every installed pack of the nine UI languages (eng rus chi_sim spa
# hin fra deu jpn ita) and reads each frame with the packs of its own
# script; or list them, '+'-joined ("eng+rus"). Each pack is a system
# package (tesseract-ocr-<lang>); the Docker image ships all nine.
# COGNIVORE_OCR_LANGUAGES=auto

# How much (0-255) a pixel's brightness must change between frames to count
# as changed when looking for a video's scenes, and the most scenes taken
# from one video.
# COGNIVORE_VIDEO_SCENE_THRESHOLD=30
# COGNIVORE_VIDEO_MAX_KEYFRAMES=200

# On a fresh (empty) knowledge base, seed it automatically with the bundled
# demo company handbooks (one per UI language) so there's something to ask
# about immediately. Never touches a knowledge base that already has
# something in it. docker-compose.yml sets this to true for you; it
# defaults to false here since a native install has no volume-isolation
# reason to want demo content injected uninvited.
# COGNIVORE_SEED_DEMO_KB=false

# Text embeddings (fastembed, ONNX -- no PyTorch). The default is multilingual
# (Russian, English, Chinese and 50+ more languages, ~220 MB, downloaded on
# first use). Changing it re-embeds an existing knowledge base on next start.
# COGNIVORE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# COGNIVORE_EMBEDDING_DIM=384

# Explainability layer: questions whose retrieval confidence falls below this
# go to the gap radar; the knowledge map draws at most this many chunks.
# COGNIVORE_GAP_THRESHOLD=0.3
# COGNIVORE_MAP_MAX_POINTS=1500

# Auto-context: search the knowledge base before every answer and give the
# model only the passages close to the best match (small local models often
# don't call the search tool themselves). With strict answers on, a question
# the knowledge base has nothing on is answered "no information" directly,
# in the question's language, instead of by the model.
# COGNIVORE_AUTO_CONTEXT=true
# COGNIVORE_AUTO_CONTEXT_THRESHOLD=0.3
# COGNIVORE_AUTO_CONTEXT_RELATIVE_SCORE=0.5
# COGNIVORE_STRICT_KNOWLEDGE_ANSWERS=true

# Upload limits for the web API, in megabytes.
# COGNIVORE_MAX_DOCUMENT_UPLOAD_MB=20
# COGNIVORE_MAX_MEDIA_UPLOAD_MB=512
