# Copy to .env and adjust. Every setting has a working, fully-local default --
# see src/cognivore/config.py for the complete list and descriptions.

# Path to a local GGUF model for llama-cpp-python. Leave unset to run with
# FakeLLMBackend (a deterministic offline demo backend -- no download needed).
# Example models: Qwen2.5-3B-Instruct-GGUF, Llama-3.2-3B-Instruct-GGUF.
# COGNIVORE_LLM_MODEL_PATH=/home/anton/models/qwen2.5-3b-instruct-q4_k_m.gguf

# COGNIVORE_LLM_CONTEXT_LENGTH=4096
# COGNIVORE_LLM_N_THREADS=8
# COGNIVORE_LLM_TEMPERATURE=0.2

# COGNIVORE_HOST=127.0.0.1
# COGNIVORE_PORT=8420

# COGNIVORE_WHISPER_MODEL_SIZE=base
